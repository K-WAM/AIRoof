# AI Model Providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Firebase Client (public, for browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-side only — complete service account JSON)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Twilio (phone integration stubs)
TWILIO_PHONE_NUMBER=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM=no-reply@luxordev.com

# Vapi (voice AI — inbound + outbound calls)
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
# VAPI_BASE_URL=https://api.vapi.ai  # optional override

# Security
CRON_SECRET=

# Legacy field-key fallback (T-034) — set "false" to disable the legacy ?key= path
# ENABLE_LEGACY_FIELD_KEY_FALLBACK=true

# Scripts (seed/provision — not used by app runtime)
ESCALATION_PHONE=
NOTIFICATION_EMAIL=
# FIREBASE_SERVICE_ACCOUNT_PATH  # alternative to FIREBASE_SERVICE_ACCOUNT_JSON for scripts

# Runtime
NODE_ENV=development
