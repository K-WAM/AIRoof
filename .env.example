# AI Model Providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Firebase Client (public, for browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-side only — complete service account JSON)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM=no-reply@luxordev.com

# Vapi (voice AI — inbound + outbound calls)
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
# VAPI_BASE_URL=https://api.vapi.ai  # optional override

# ElevenLabs Agents (Phase 19 — per-tenant voiceProvider switch)
# ELEVENLABS_API_KEY: personal/workspace API key for the convai API + provisioning
#   script (scripts/setup-elevenlabs-agent.mjs). NEVER paste it in chat.
# ELEVENLABS_WEBHOOK_SECRET: random 40+ char string; shared secret for the
#   post-call webhook HMAC (ElevenLabs-Signature). Paste the SAME value into
#   ElevenLabs' workspace webhook "signing secret".
# ELEVENLABS_TOOL_SECRET: random 40+ char string; authenticates the conversation-
#   initiation webhook AND the 7 webhook tools (x-luxor-tool-secret header).
#   Paste the SAME value into the ElevenLabs secrets manager (workspace secret
#   "LUXOR_TOOL_SECRET") and Vercel. See docs/ELEVENLABS-SETUP.md.
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_TOOL_SECRET=
# ELEVENLABS_API_BASE=https://api.elevenlabs.io  # optional override

# Stripe (optional — Payment Links on Luxor invoices; unset = "Generate
# payment link" reports "not configured" instead of failing)
STRIPE_SECRET_KEY=

# App base URL (T-095) — absolute origin used in booking-confirmation emails,
# team-invite links, and demo/QR links. Unset = falls back to the current
# production domain (src/lib/config/appUrl.ts), so this is safe to leave unset
# until the luxordev.com domain move is ready; set per-environment in Vercel.
# NEXT_PUBLIC_APP_URL=https://ai-roof.vercel.app

# Security
CRON_SECRET=

# Legacy field-key fallback (T-034) — set "false" to disable the legacy ?key= path
# ENABLE_LEGACY_FIELD_KEY_FALLBACK=true

# Operational scripts read the gitignored firebase-service-account.json file
# from the repository root. Never commit that credential.

# Runtime
NODE_ENV=development
